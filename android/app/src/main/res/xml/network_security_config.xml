<?xml version="1.0" encoding="utf-8"?>
<!-- The X-Plane web API is plain HTTP on the local network (user-entered IP),
     so cleartext must be allowed. All internet services use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
